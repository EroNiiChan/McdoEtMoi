[Unit]
Description=McDo Bot Medallia Automation
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/mcdo-bot
EnvironmentFile=-/root/mcdo-bot/.env
ExecStart=/root/mcdo-bot/venv/bin/python /root/mcdo-bot/script.py
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
